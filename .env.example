# Public Supabase URL. Safe to expose to the browser if needed.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional public anon key for future authenticated browser features.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App base URL for server-generated links.
APP_URL=http://localhost:3000
